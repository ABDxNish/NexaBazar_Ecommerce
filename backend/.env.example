# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
SESSION_SECRET=change-this-to-a-long-random-secret
COOKIE_SECURE=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nexabazar
DB_SYNCHRONIZE=true

# Google OAuth - create credentials in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Pusher - optional. The app still runs if these are blank.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# SMTP / Mailer - optional. Set MAIL_ENABLED=true after adding real SMTP credentials.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=NexaBazar <no-reply@nexabazar.local>

# SSLCOMMERZ
# Create sandbox credentials from https://sandbox-gw.sslcommerz.com/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
